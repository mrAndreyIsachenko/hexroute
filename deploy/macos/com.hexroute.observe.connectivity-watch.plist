<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hexroute.observe.connectivity-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/Hexroute/observe-root/bin/hexroute-connectivity-watch</string>
		<string>--store</string>
		<string>/Library/Application Support/Hexroute/observe-root/state/connectivity</string>
		<string>--state</string>
		<string>/Library/Application Support/Hexroute/observe-root/state/connectivity-watch.json</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Library/Application Support/Hexroute/observe-root/state</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/Hexroute/observe-root/connectivity-watch.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Hexroute/observe-root/connectivity-watch.err.log</string>
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>64</integer>
	</dict>
</dict>
</plist>
